# Copy to .env.local and fill in. Firebase console -> Project settings -> Your apps -> Web app.
# These are not secrets (they ship in the page); firestore.rules and the admin list protect the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=

# Only for trying the dashboard against the local Firebase emulators (see tools/emulator-tests). Leave unset for the real project.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1
